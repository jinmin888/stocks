# 复制为 .env 并填写。不要提交 .env。
APP_USERNAME=admin
APP_PASSWORD=请设置一个强密码
# 用于签名登录 Cookie，随机长字符串：python -c "import secrets;print(secrets.token_hex(32))"
SECRET_KEY=
# 网站对外地址（KakaoTalk 消息里的链接会用到）
PUBLIC_URL=http://localhost:8000
# 启用 HTTPS 后设为 1
COOKIE_SECURE=0

# 韩国交易所数据平台账号（韩国股市全市场 / 指数扫描）
KRX_ID=
KRX_PW=

# KakaoTalk「나에게 보내기」：Kakao Developers 应用的 REST API 키（Client Secret 启用时也要填）
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=
# 通知消息语言：zh / ko
NOTIFY_LANG=zh

# 有域名后填写（如 screener.example.com），并把 PUBLIC_URL 改为 https://域名、COOKIE_SECURE=1
DOMAIN=
